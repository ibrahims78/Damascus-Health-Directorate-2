{
  "name": "damascus-health-directorate-desktop",
  "productName": "Damascus Health Directorate",
  "version": "5.0.6",
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "pnpm run build:api && pnpm run build:web",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:web": "pnpm --filter @workspace/web run build",
    "lint": "eslint .",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs --write",
    "db:migrate": "pnpm --filter @workspace/db run db:migrate",
    "db:readiness": "pnpm --filter @workspace/db run db:readiness",
    "db:generate": "pnpm --filter @workspace/db run db:generate"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.1"
  }
}
